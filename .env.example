# ─── Vantage Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in REAL values before starting the server.
# NEVER commit the .env file — it is listed in .gitignore.
# All variables marked REQUIRED must be set or the app will refuse to start.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ──────────────────────────────────────────────────────────────────
# REQUIRED. Use "production" in deployment, "development" locally.
FLASK_ENV=production

# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING

# ── Database ───────────────────────────────────────────────────────────────
# REQUIRED. Full PostgreSQL connection URL.
# Supabase example: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT ────────────────────────────────────────────────────────────────────
# REQUIRED. Must differ from SECRET_KEY.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_DIFFERENT_32_CHAR_RANDOM_STRING

# Token lifetimes (seconds). Defaults shown.
JWT_ACCESS_TOKEN_EXPIRES=900     # 15 minutes
JWT_REFRESH_TOKEN_EXPIRES=604800 # 7 days

# ── Redis ─────────────────────────────────────────────────────────────────
# REQUIRED for production. Used for JWT blocklist and rate limiting.
# Use a remote Redis service — localhost will NOT work in multi-worker deployment.
# Upstash example: rediss://default:PASSWORD@HOST:PORT
REDIS_URL=rediss://username:password@your-redis-host:6380

# ── Supabase Storage ──────────────────────────────────────────────────────
# REQUIRED in production. Without these, T-Sheet files fall back to local disk.
# Get values from: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY

# ── Admin Seed Account ────────────────────────────────────────────────────
# REQUIRED. Created on first startup if no admin/owner exists.
# Password MUST be at least 16 characters.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_20_CHAR_RANDOM_PASSWORD

# ── Error Monitoring ─────────────────────────────────────────────────────
# Optional. Leave blank to disable Sentry. Free tier at sentry.io is sufficient.
SENTRY_DSN=

# ── CORS ─────────────────────────────────────────────────────────────────
# REQUIRED in production. Comma-separated list of allowed frontend origins.
# Example: https://vantage.yourdomain.com
# Set to http://localhost:5000 for local development only.
FRONTEND_ORIGIN=https://your-production-domain.com
